rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(dogId) {
      return exists(
        /databases/$(database)/documents/dogs/$(dogId)/members/$(request.auth.uid)
      )
      && get(
        /databases/$(database)/documents/dogs/$(dogId)/members/$(request.auth.uid)
      ).data.role == 'owner';
    }

    function isDogMember(dogId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/dogs/$(dogId)/members/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/dogs/$(dogId)/members/$(request.auth.uid)
        ).data.status == 'active';
    }

    function canManageDogMedia(dogId) {
      return isDogMember(dogId)
        && get(
          /databases/$(database)/documents/dogs/$(dogId)/members/$(request.auth.uid)
        ).data.role in ['owner', 'editor', 'admin'];
    }

    function canWriteDogHealth(dogId) {
      return isDogMember(dogId)
        && get(
          /databases/$(database)/documents/dogs/$(dogId)/members/$(request.auth.uid)
        ).data.role in ['owner', 'editor', 'admin'];
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isCalendarDateString(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidHealthRecordData(data) {
      return data.schemaVersion == 1
        && data.id is string
        && data.cloudDogId is string
        && data.type is string
        && data.title is string
        && isCalendarDateString(data.recordedDate)
        && data.repeatKind is string
        && data.createdByUserId is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isNullableString(data.dogKey)
        && isNullableString(data.description)
        && isNullableString(data.productName)
        && isNullableString(data.dose)
        && (data.nextDueDate == null
          || isCalendarDateString(data.nextDueDate))
        && (data.deletedAt == null || data.deletedAt is timestamp)
        && (
          (data.repeatKind == 'customDays'
            && data.customDays is int
            && data.customDays > 0)
          || (data.repeatKind != 'customDays' && data.customDays == null)
        );
    }

    function isOwnerMemberCreate(dogId, memberId) {
      return isSignedIn()
        && memberId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'owner'
        && get(
          /databases/$(database)/documents/dogs/$(dogId)
        ).data.cloudOwnerUid == request.auth.uid;
    }

    function isOwnMemberDoc(memberId) {
      return isSignedIn() && request.auth.uid == memberId;
    }

    function isOwnMemberData() {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function isMemberResourceOwnedByCurrentUser() {
      return isSignedIn()
        && resource != null
        && resource.data.uid == request.auth.uid;
    }

    function inviteAllowsSelfMembership(dogId) {
      return isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.role in ['editor', 'viewer']
        && request.resource.data.acceptedInviteId is string
        && exists(
          /databases/$(database)/documents/shareInvites/$(request.resource.data.acceptedInviteId)
        )
        && (
          get(
            /databases/$(database)/documents/shareInvites/$(request.resource.data.acceptedInviteId)
          ).data.recipientEmail == request.auth.token.email
          || get(
            /databases/$(database)/documents/shareInvites/$(request.resource.data.acceptedInviteId)
          ).data.recipientUserId == request.auth.uid
        )
        && get(
          /databases/$(database)/documents/shareInvites/$(request.resource.data.acceptedInviteId)
        ).data.status in ['pending', 'accepted']
        && (
          get(
            /databases/$(database)/documents/shareInvites/$(request.resource.data.acceptedInviteId)
          ).data.cloudDogId == dogId
          || get(
            /databases/$(database)/documents/shareInvites/$(request.resource.data.acceptedInviteId)
          ).data.dogKey == get(
            /databases/$(database)/documents/dogs/$(dogId)
          ).data.dogKey
        );
    }

    function isSelfMembershipRevoke(memberId) {
      return isSignedIn()
        && (
          memberId == request.auth.uid
          || isMemberResourceOwnedByCurrentUser()
        )
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'revoked';
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /{path=**}/members/{memberId} {
      allow get: if isOwnMemberDoc(memberId) || isOwnMemberData();
      allow list: if isOwnMemberData();
    }

    match /dogs/{dogId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.cloudOwnerUid == request.auth.uid;

      allow update: if isDogMember(dogId);
      allow delete: if isSignedIn() && isOwner(dogId);

      match /members/{memberId} {
        allow get: if isOwnMemberDoc(memberId)
          || isOwnMemberData()
          || isOwner(dogId);

        allow list: if isOwnMemberData() || isOwner(dogId);

        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && (
            isOwnerMemberCreate(dogId, memberId)
            || inviteAllowsSelfMembership(dogId)
          );

        allow update: if isSignedIn()
          && (
            isOwner(dogId)
            || (memberId == request.auth.uid && inviteAllowsSelfMembership(dogId))
            || isSelfMembershipRevoke(memberId)
          );

        allow delete: if isSignedIn()
          && (
            isOwner(dogId)
            || memberId == request.auth.uid
            || isMemberResourceOwnedByCurrentUser()
          );
      }

      match /sessions/{sessionId} {
        allow read, create, update: if isDogMember(dogId);
      }

      match /tracks/{trackId} {
        allow read, create, update: if isDogMember(dogId);
      }

      match /media/{mediaId} {
        allow read: if isDogMember(dogId);
        allow create, update, delete: if canManageDogMedia(dogId);
      }

      match /healthRecords/{healthRecordId} {
        allow read: if isDogMember(dogId);
        allow create: if canWriteDogHealth(dogId)
          && request.resource.data.id == healthRecordId
          && request.resource.data.cloudDogId == dogId
          && isValidHealthRecordData(request.resource.data);
        allow update: if canWriteDogHealth(dogId)
          && isValidHealthRecordData(request.resource.data)
          && request.resource.data.id == healthRecordId
          && request.resource.data.id == resource.data.id
          && request.resource.data.cloudDogId == dogId
          && request.resource.data.cloudDogId == resource.data.cloudDogId
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            ('createdByUserId' in resource.data
              && request.resource.data.createdByUserId == resource.data.createdByUserId)
            || (!('createdByUserId' in resource.data)
              && 'createdBy' in resource.data
              && request.resource.data.createdByUserId == resource.data.createdBy)
          )
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.dogKey == resource.data.dogKey
          && request.resource.data.updatedAt >= resource.data.updatedAt;
      }
    }

    match /shareInvites/{inviteId} {
      allow create: if isSignedIn()
        && request.resource.data.createdByAuthUid == request.auth.uid;

      allow get, list: if isSignedIn()
        && (
          resource.data.createdByAuthUid == request.auth.uid
          || resource.data.recipientEmail == request.auth.token.email
          || resource.data.recipientUserId == request.auth.uid
        );

      allow update: if isSignedIn()
        && (
          resource.data.createdByAuthUid == request.auth.uid
          || resource.data.recipientEmail == request.auth.token.email
          || resource.data.recipientUserId == request.auth.uid
        );
    }
  }
}
