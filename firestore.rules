rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(dogId) {
      return exists(
        /databases/$(database)/documents/dogs/$(dogId)/members/$(request.auth.uid)
      )
      && get(
        /databases/$(database)/documents/dogs/$(dogId)/members/$(request.auth.uid)
      ).data.role == 'owner';
    }

    function isDogMember(dogId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/dogs/$(dogId)/members/$(request.auth.uid)
        );
    }

    function isOwnMemberDoc(memberId) {
      return isSignedIn() && request.auth.uid == memberId;
    }

    function isOwnMemberData() {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /{path=**}/members/{memberId} {
      allow get: if isOwnMemberDoc(memberId) || isOwnMemberData();
      allow list: if isOwnMemberData();
    }

    match /dogs/{dogId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.cloudOwnerUid == request.auth.uid;

      allow update, delete: if isSignedIn() && isOwner(dogId);

      match /members/{memberId} {
        allow get: if isOwnMemberDoc(memberId)
          || isOwnMemberData()
          || isOwner(dogId);

        allow list: if isOwnMemberData();

        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.role == 'owner';

        allow update: if isSignedIn()
          && (
            isOwner(dogId)
            || (
              memberId == request.auth.uid
              && resource.data.uid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.status in ['revoked', 'left']
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt'])
            )
          );

        allow delete: if isSignedIn()
          && (
            isOwner(dogId)
            || memberId == request.auth.uid
          );
      }

      match /sessions/{sessionId} {
        allow read, create, update: if isDogMember(dogId);
      }
    }
  }
}
