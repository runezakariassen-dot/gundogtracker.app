{
  "name": "jakthund-app-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "test:rules:track": "firebase emulators:exec --config ../firebase.json --project demo-jakthund-track-rules --only firestore,storage \"node --test test/rules/track_cloud_rules.test.js\"",
    "test:rules:events": "firebase emulators:exec --config ../firebase.json --project demo-jakthund-event-rules --only firestore \"node --test test/rules/hunt_event_rules.test.js\"",
    "lint": "eslint --ext .js,.ts src",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^4.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "typescript": "^5.4.5"
  }
}
